# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Beta Password
BETA_PASSWORD=resolut-beta-2026

# Feature Flags
# Set to 'true' to enable Negotiate feature (for local testing)
# Leave unset or set to 'false' for production
NEXT_PUBLIC_NEGOTIATE_ENABLED=true

# Mailchimp Configuration
# Get your API key from: https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Get your Audience ID from: Account > Audience > Settings > Audience name and defaults
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Server prefix from your Mailchimp account (e.g., us15, us20)
# Found in your API key or Mailchimp URL
MAILCHIMP_SERVER_PREFIX=us15
